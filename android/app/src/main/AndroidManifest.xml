<?xml version="1.0" encoding="utf-8"?>
<!-- Karanlık Oda 2.0: Trusted Web Activity (Stüdyo APK 2.0 ile aynı çözüm). Sayfa (https://aaskinkk-cloud.github.io/karanlik-oda/) telefondaki
     Chrome ile tam ekran açılır; WebView'deki grafik birimi çökmesi yok. Doğrulama: https://aaskinkk-cloud.github.io/.well-known/assetlinks.json -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <intent><action android:name="android.support.customtabs.action.CustomTabsService" /></intent>
    </queries>
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Karanlık Oda"
        android:theme="@style/Okur">
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="Karanlık Oda"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <meta-data android:name="android.support.customtabs.trusted.DEFAULT_URL" android:value="https://aaskinkk-cloud.github.io/karanlik-oda/?app=ko" />
            <meta-data android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR" android:resource="@color/zemin" />
            <meta-data android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR" android:resource="@color/zemin" />
            <meta-data android:name="android.support.customtabs.trusted.DISPLAY_MODE" android:value="sticky-immersive" />
            <meta-data android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY" android:value="customtabs" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="aaskinkk-cloud.github.io" android:pathPrefix="/karanlik-oda/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
